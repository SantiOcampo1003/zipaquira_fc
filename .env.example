# Copia a .env.local (ese archivo no se sube a Git)

NEXT_PUBLIC_SUPABASE_URL=https://irotkgjkmtkjvcxnzujf.supabase.co

# Publishable key (pestaña "Publishable and secret API keys")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (la que empieza por sb_secret_...) — OBLIGATORIA para /api/boletas
# Alternativa: pestaña "Legacy anon, service_role" → service_role (eyJ...)
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (para armar el link de Tu Boleta en los correos)
SITE_URL=https://zipaquira-fc-eta.vercel.app

# Secreto compartido con el Apps Script del sheet "compras tu boleta"
# (mismo valor en Propiedades de secuencia de comandos → ADMIN_SECRET)
ABONOS_ADMIN_SECRET=

# Secreto del panel humano /tribuna/admin?key=... (dárselo a una sola persona)
TRIBUNA_ADMIN_SECRET=

# Venta directa de boletas en línea (Wompi) — sacar en comercios.wompi.co
# → Desarrolladores → Secretos para integración técnica (modo sandbox primero)
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Envío del PDF de la boleta por correo (resend.com, con dominio verificado)
RESEND_API_KEY=
RESEND_FROM_EMAIL=boletas@zipaquirafc.com

# Secreto del escáner de entrada /tickets/scan?key=... (dárselo a logística)
GATE_STAFF_SECRET=
